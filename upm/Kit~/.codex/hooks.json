{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/scripts/check_unity_meta.py",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .agents/scripts/check-unity-meta.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/scripts/usage_report.py",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .agents/scripts/usage-report.ps1"
          }
        ]
      }
    ]
  }
}
