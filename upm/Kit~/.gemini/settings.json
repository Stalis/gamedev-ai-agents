{
  "telemetry": {
    "enabled": true,
    "target": "local",
    "outfile": ".agents/usage/gemini-telemetry.log",
    "logPrompts": false
  },
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "unity-meta-check",
            "command": "python3 .agents/scripts/check_unity_meta.py",
            "description": "Rendered from global/canon/hooks.json."
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "usage-report",
            "command": "python3 .agents/scripts/usage_report.py",
            "description": "Rendered from global/canon/hooks.json."
          }
        ]
      }
    ]
  }
}
